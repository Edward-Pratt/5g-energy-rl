import time
import zmq
import numpy as np
import veinsgym_pb2 as pb
import csv
from datetime import datetime
import torch
from torch import nn
from torch.distributions import Categorical
from torch.optim import Adam


# ---------------- PPO bits (tiny implementation) ----------------

class PolicyNet(nn.Module):
    def __init__(self, obs_dim, act_dim):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(obs_dim, 64), nn.Tanh(),
            nn.Linear(64, 64), nn.Tanh(),
        )
        self.pi = nn.Linear(64, act_dim)
        self.v  = nn.Linear(64, 1)

    def forward(self, x):
        h = self.net(x)
        return self.pi(h), self.v(h)


class PPOAgent:
    def __init__(self, obs_dim=6, act_dim=3, lr=3e-4, gamma=0.99, lam=0.95, clip=0.2, ent=0.01):
        self.obs_dim = obs_dim
        self.act_dim = act_dim
        self.gamma = gamma
        self.lam = lam
        self.clip = clip
        self.ent = ent

        self.model = PolicyNet(obs_dim, act_dim)
        self.opt = Adam(self.model.parameters(), lr=lr)

        self.reset_buffer()

    def reset_buffer(self):
        self.obs_buf = []
        self.act_buf = []
        self.logp_buf = []
        self.rew_buf = []
        self.val_buf = []
        self.done_buf = []

    @torch.no_grad()
    def act(self, obs):
        x = torch.tensor(obs, dtype=torch.float32).unsqueeze(0)
        logits, v = self.model(x)
        dist = Categorical(logits=logits)
        a = dist.sample()
        logp = dist.log_prob(a)
        return int(a.item()), float(logp.item()), float(v.item())

    def store(self, obs, act, logp, rew, val, done):
        self.obs_buf.append(obs)
        self.act_buf.append(act)
        self.logp_buf.append(logp)
        self.rew_buf.append(rew)
        self.val_buf.append(val)
        self.done_buf.append(done)

    def _finish_path(self, last_val=0.0):
        # GAE-Lambda
        rews = np.array(self.rew_buf, dtype=np.float32)
        vals = np.array(self.val_buf + [last_val], dtype=np.float32)
        dones = np.array(self.done_buf, dtype=np.float32)

        adv = np.zeros_like(rews)
        gae = 0.0
        for t in reversed(range(len(rews))):
            nonterminal = 1.0 - dones[t]
            delta = rews[t] + self.gamma * vals[t+1] * nonterminal - vals[t]
            gae = delta + self.gamma * self.lam * nonterminal * gae
            adv[t] = gae

        ret = adv + vals[:-1]
        # normalize advantages
        adv = (adv - adv.mean()) / (adv.std() + 1e-8)
        return adv, ret

    def update(self, epochs=10, batch_size=64):
        obs = torch.tensor(np.array(self.obs_buf), dtype=torch.float32)
        act = torch.tensor(np.array(self.act_buf), dtype=torch.int64)
        old_logp = torch.tensor(np.array(self.logp_buf), dtype=torch.float32)
        adv, ret = self._finish_path(last_val=0.0)
        adv = torch.tensor(adv, dtype=torch.float32)
        ret = torch.tensor(ret, dtype=torch.float32)

        n = len(obs)
        idxs = np.arange(n)

        for _ in range(epochs):
            np.random.shuffle(idxs)
            for start in range(0, n, batch_size):
                mb = idxs[start:start+batch_size]
                logits, v = self.model(obs[mb])
                dist = Categorical(logits=logits)
                logp = dist.log_prob(act[mb])
                ratio = torch.exp(logp - old_logp[mb])

                clip_adv = torch.clamp(ratio, 1 - self.clip, 1 + self.clip) * adv[mb]
                pi_loss = -(torch.min(ratio * adv[mb], clip_adv)).mean()

                v_loss = 0.5 * (ret[mb] - v.squeeze(1)).pow(2).mean()
                ent = dist.entropy().mean()

                loss = pi_loss + v_loss - self.ent * ent

                self.opt.zero_grad()
                loss.backward()
                self.opt.step()

        self.reset_buffer()


# ---------------- ZMQ server ----------------

def main():

     
    logf = open("rollout.csv", "a", newline="")
    writer = csv.writer(logf)
    if logf.tell() == 0:
        writer.writerow(["ts","episode","t","thr","delay","jitter","loss","numUe","stepEnergyJ","rew","act"])      
    ctx = zmq.Context.instance()
    sock = ctx.socket(zmq.REP)
    sock.bind("tcp://127.0.0.1:5555")
    print("[PPO] Listening on 127.0.0.1:5555")

    agent = PPOAgent(obs_dim=6, act_dim=3)

    last_obs = None
    last_act = None
    last_logp = None
    last_val = None
    episode = 0
    ep_return = 0.0
    steps = 0
    update_every = 512  # rollout size for PPO update (small for PoC)

    while True:
        msg = sock.recv()
        req = pb.Request()
        req.ParseFromString(msg)

        
        if req.HasField("shutdown"):

            print("[PPO] Shutdown from OMNeT (episode finished)")
            if len(agent.obs_buf) > 32:
                agent.update()
                print("[PPO] Final update done")
            print(f"[PPO] Episode return: {ep_return:.3f} | steps: {steps}")
            if len(agent.done_buf) > 0:
                agent.done_buf[-1] = 1.0
            # reset episode state
            episode +=1
            agent.reset_buffer()
            torch.save(agent.model.state_dict(), "ppo_policy.pt")
            last_obs = None
            ep_return = 0.0
            steps = 0
            reply = pb.Reply()
            reply.id = req.id
            sock.send(reply.SerializeToString())
            continue


        # INIT: OMNeT sends action/obs space code. Reply empty is fine.
        if req.HasField("init"):
            print("[PPO] Init received")
            last_obs = None
            ep_return = 0.0
            steps = 0
            sock.send(pb.Reply().SerializeToString())
            continue

        # STEP: contains observation and reward (reward is for previous action in many setups)
        if req.HasField("step"):
            obs = np.array(req.step.observation.box.values, dtype=np.float32)
            rew = 0.0
            if req.step.reward and req.step.reward.HasField("box") and len(req.step.reward.box.values) > 0:
                rew = float(req.step.reward.box.values[0])

            # Store transition from last step (if we have one)
            if last_obs is not None:
                done = 0.0  # episodes end when OMNeT shuts down; for PoC keep false
                agent.store(last_obs, last_act, last_logp, rew, last_val, done)
                ep_return += rew
                steps += 1

                if len(agent.obs_buf) >= update_every:
                    agent.update()
                    print(f"[PPO] Update done @ step={steps}  ep_return≈{ep_return:.3f}")

            # Choose next action
            a, logp, v = agent.act(obs)
            
            thr, delay, jitter, loss, numUe, stepE = obs.tolist()
            writer.writerow([time.time(), episode, steps, thr, delay, jitter, loss, numUe, stepE, rew, a])
            logf.flush()


            last_obs = obs
            last_act = a
            last_logp = logp
            last_val = v
            if steps % 20 == 0:
                print(f"[PPO] step={steps} rew={rew:.4f} act={a} obs[0..2]={obs[:3]}")
                    

            reply = pb.Reply()
            reply.id = req.id
            reply.action.discrete.value = int(a)
            sock.send(reply.SerializeToString())
            continue

        # Fallback
        sock.send(pb.Reply().SerializeToString())


if __name__ == "__main__":
    main()

