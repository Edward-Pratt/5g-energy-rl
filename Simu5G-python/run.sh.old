#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

OMNET="$ROOT/omnetpp-6.3.0"

export PATH="$OMNET/bin:$PATH"

_omnet_ld=""
[[ -d "$OMNET/lib"   ]] && _omnet_ld="$OMNET/lib"
[[ -d "$OMNET/lib64" ]] && _omnet_ld="${_omnet_ld:+$_omnet_ld:}$OMNET/lib64"
export LD_LIBRARY_PATH="${_omnet_ld}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

export OMNETPP_CONFIGFILE="$OMNET/Makefile.inc"

GYM_DIR="$ROOT/Simu5G-Gym/simulations/standalone"
EXE="$ROOT/Simu5G-Gym/src/Simu5G-Gym"
NEDPATH="$ROOT/Simu5G-Gym/ned:$ROOT/Simu5G-Gym/src:$ROOT/Simu5G/src/simu5g:$ROOT/inet/src"

PY="$SCRIPT_DIR/.venv/bin/python"

# ── Defaults ──────────────────────────────────────────────────────────────────
AGENT="ppo"
NUM_EPISODES=1
MODE="eval"
GREEDY=false
CHECKPOINT=""
SCENARIO="CBR-DL-PPO"     # omnetpp.ini [Config ...] name
RUN_INDEX=0               # -r value passed to the simulator
LOG_OVERRIDE=""

# Valid scenarios – used for validation and tab-completion hint in usage
VALID_SCENARIOS=(
  # ── Original working configs ──
  "CBR-DL-PPO"
  "CBR-DL-DQN"
  "VoIP-DL-PPO"
  "VoIP-DL-DQN"
  # ── Curriculum: static interference ──
  "Curriculum-Stage1-Easy"
  "Curriculum-Stage2-LightInterference"
  "Curriculum-Stage3-FullStatic"
  # ── Curriculum: mobile ──
  "Curriculum-Stage4-SingleMobile"
  "Curriculum-Stage5-MultiStatic"
  "Curriculum-Stage6-MultiMobile"
  # ── Stress tests ──
  "Stress-HighInterference"
  "Stress-CellEdge"
  "Stress-Dense"
  # ── Evaluation ──
  "Eval-PPO"
  "Eval-DQN"
  "Eval-Compare-PPO"
  "Eval-Compare-DQN"
  "Eval-Mobile-PPO"
  "Eval-Mobile-DQN"
  "Eval-Dynamic-DQN"
  "Eval-Dynamic-PPO"
)

# DQN defaults
DQN_N_ACTIONS=21
DQN_LR="1e-3"
DQN_GAMMA="0.99"
DQN_BUF_SIZE=50000
DQN_BATCH_SIZE=64
DQN_TARGET_UPDATE=500
DQN_EPS_START="1.0"
DQN_EPS_END="0.05"
DQN_EPS_DECAY=10000

# PPO defaults
PPO_UPDATE_EVERY=512
PPO_SAVE_EVERY=1

# ── Usage ──────────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Usage: \\$0 [OPTIONS]

General options:
  --agent AGENT          Which agent to use: ppo | dqn        (default: ppo)
  --episodes N           Number of episodes to run            (default: 1)
  --mode MODE            train | eval                         (default: eval)
  --scenario NAME        OMNeT++ config to run                (default: CBR-DL-PPO)
  --run N                Simulation run index (-r N)          (default: 0)
  --checkpoint FILE      Checkpoint path (default: <agent>_policy.pt)
  --greedy               Deterministic policy in eval         (PPO only)
  --list-scenarios       Print all valid scenario names
  -h, --help             Show this help

PPO-specific options:
  --update_every N       Steps between PPO updates            (default: 512)
  --save_every N         Save checkpoint every N episodes     (default: 1)

DQN-specific options:
  --n_actions N          Discrete action bins                 (default: 21)
  --lr LR                Learning rate                        (default: 1e-3)
  --gamma G              Discount factor                      (default: 0.99)
  --buf_size N           Replay buffer capacity               (default: 50000)
  --batch_size N         Minibatch size                       (default: 64)
  --target_update N      Hard target-net update period        (default: 500)
  --eps_start E          Initial epsilon                      (default: 1.0)
  --eps_end E            Final epsilon                        (default: 0.05)
  --eps_decay N          Epsilon decay steps                  (default: 10000)

── Scenario quick-reference ──────────────────────────────────────────────────
  Original (static interference):
    CBR-DL-PPO / CBR-DL-DQN
    VoIP-DL-PPO / VoIP-DL-DQN

  Curriculum – static (run in order):
    Curriculum-Stage1-Easy
    Curriculum-Stage2-LightInterference
    Curriculum-Stage3-FullStatic

  Curriculum – mobile (continue from Stage3 checkpoint):
    Curriculum-Stage4-SingleMobile
    Curriculum-Stage5-MultiStatic
    Curriculum-Stage6-MultiMobile

  Stress tests (eval mode only):
    Stress-HighInterference / Stress-CellEdge / Stress-Dense

  Evaluation (fixed seed=42 for fair comparison):
    Eval-PPO / Eval-DQN
    Eval-Compare-PPO / Eval-Compare-DQN
    Eval-Mobile-PPO  / Eval-Mobile-DQN

── Examples ──────────────────────────────────────────────────────────────────
  # Original scenario, PPO eval
  \\$0 --agent ppo --mode eval --episodes 10

  # Original scenario, DQN train
  \\$0 --agent dqn --mode train --episodes 200

  # Curriculum stage 1 – DQN, train from scratch
  \\$0 --agent dqn --mode train --episodes 100 \\
     --scenario Curriculum-Stage1-Easy \\
     --checkpoint dqn_stage1.pt

  # Curriculum stage 2 – continue from stage 1 checkpoint
  \\$0 --agent dqn --mode train --episodes 150 \\
     --scenario Curriculum-Stage2-LightInterference \\
     --checkpoint dqn_stage1.pt

  # Stress test a trained model
  \\$0 --agent dqn --mode eval --episodes 20 \\
     --scenario Stress-HighInterference \\
     --checkpoint dqn_policy.pt

  # Fair head-to-head comparison (both use seed=42 via Eval-Compare-* config)
  \\$0 --agent ppo --mode eval --episodes 20 --scenario Eval-Compare-PPO
  \\$0 --agent dqn --mode eval --episodes 20 --scenario Eval-Compare-DQN
EOF
  exit 0
}

list_scenarios() {
  echo "Valid scenarios:"
  for s in "${VALID_SCENARIOS[@]}"; do
    echo "  $s"
  done
  exit 0
}

# ── Argument parsing ───────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  arg="$1"

  if [[ "$arg" == "-h" ]] || [[ "$arg" == "--help" ]]; then
    usage

  elif [[ "$arg" == "--list-scenarios" ]]; then
    list_scenarios

  elif [[ "$arg" == "--agent" ]]; then
    AGENT="$2"; shift 2

  elif [[ "$arg" == "--episodes" ]]; then
    NUM_EPISODES="$2"; shift 2

  elif [[ "$arg" == "--mode" ]]; then
    MODE="$2"; shift 2

  elif [[ "$arg" == "--scenario" ]]; then
    SCENARIO="$2"; shift 2

  elif [[ "$arg" == "--run" ]]; then
    RUN_INDEX="$2"; shift 2

  elif [[ "$arg" == "--checkpoint" ]]; then
    CHECKPOINT="$2"; shift 2

  elif [[ "$arg" == "--greedy" ]]; then
    GREEDY=true; shift

  elif [[ "$arg" == "--update_every" ]]; then
    PPO_UPDATE_EVERY="$2"; shift 2

  elif [[ "$arg" == "--save_every" ]]; then
    PPO_SAVE_EVERY="$2"; shift 2

  elif [[ "$arg" == "--n_actions" ]]; then
    DQN_N_ACTIONS="$2"; shift 2

  elif [[ "$arg" == "--lr" ]]; then
    DQN_LR="$2"; shift 2

  elif [[ "$arg" == "--gamma" ]]; then
    DQN_GAMMA="$2"; shift 2

  elif [[ "$arg" == "--buf_size" ]]; then
    DQN_BUF_SIZE="$2"; shift 2

  elif [[ "$arg" == "--batch_size" ]]; then
    DQN_BATCH_SIZE="$2"; shift 2

  elif [[ "$arg" == "--target_update" ]]; then
    DQN_TARGET_UPDATE="$2"; shift 2

  elif [[ "$arg" == "--eps_start" ]]; then
    DQN_EPS_START="$2"; shift 2

  elif [[ "$arg" == "--eps_end" ]]; then
    DQN_EPS_END="$2"; shift 2

  elif [[ "$arg" == "--eps_decay" ]]; then
    DQN_EPS_DECAY="$2"; shift 2

  elif [[ "$arg" == "--log" ]]; then
    LOG_OVERRIDE="$2"; shift 2

  else
    echo "Unknown option: $arg" >&2
    echo "Use -h or --help for usage" >&2
    exit 1
  fi
done

# ── Validate agent ─────────────────────────────────────────────────────────────
if [[ "$AGENT" == "ppo" ]]; then
  SERVER="$SCRIPT_DIR/serverppo.py"
elif [[ "$AGENT" == "dqn" ]]; then
  SERVER="$SCRIPT_DIR/serverdqn.py"
else
  echo "Error: --agent must be ppo or dqn, got: $AGENT" >&2
  exit 1
fi

# ── Validate mode ──────────────────────────────────────────────────────────────
if [[ "$MODE" != "train" ]] && [[ "$MODE" != "eval" ]]; then
  echo "Error: --mode must be train or eval, got: $MODE" >&2
  exit 1
fi

# ── Validate scenario ──────────────────────────────────────────────────────────
scenario_valid=false
for s in "${VALID_SCENARIOS[@]}"; do
  if [[ "$s" == "$SCENARIO" ]]; then
    scenario_valid=true
    break
  fi
done
if [[ "$scenario_valid" == false ]]; then
  echo "Error: unknown scenario '$SCENARIO'" >&2
  echo "Run with --list-scenarios to see all valid options" >&2
  exit 1
fi

# ── Warn if scenario/mode combination looks wrong ─────────────────────────────
if [[ "$SCENARIO" == Stress-* ]] && [[ "$MODE" == "train" ]]; then
  echo "Warning: stress-test scenarios are intended for eval mode, not train" >&2
fi

if [[ "$SCENARIO" == Eval-* ]] && [[ "$MODE" == "train" ]]; then
  echo "Warning: eval scenarios are intended for eval mode, not train" >&2
fi

if [[ "$SCENARIO" == Curriculum-* ]] && [[ "$MODE" == "eval" ]]; then
  echo "Warning: curriculum scenarios are intended for train mode, not eval" >&2
fi

# ── Default checkpoint ─────────────────────────────────────────────────────────
if [[ -z "$CHECKPOINT" ]]; then
  CHECKPOINT="$SCRIPT_DIR/${AGENT}_policy.pt"
fi

# ── Sanity checks ──────────────────────────────────────────────────────────────
[[ -d "$GYM_DIR" ]] || { echo "Missing GYM_DIR: $GYM_DIR" >&2; exit 1; }
[[ -x "$EXE"     ]] || { echo "Missing/not-executable EXE: $EXE" >&2; exit 1; }
[[ -f "$SERVER"  ]] || { echo "Missing SERVER script: $SERVER" >&2; exit 1; }
[[ -x "$PY"      ]] || {
  echo "Missing Python interpreter: $PY" >&2
  echo "Tip: python3 -m venv $SCRIPT_DIR/.venv" >&2
  exit 1
}

if [[ "$MODE" == "eval" ]] && [[ ! -f "$CHECKPOINT" ]]; then
  echo "Error: checkpoint not found: $CHECKPOINT" >&2
  exit 1
fi

if [[ "$GREEDY" == true ]] && [[ "$AGENT" == "dqn" ]]; then
  echo "Note: --greedy has no effect for DQN (eval is always greedy)" >&2
fi




# ── Build server command ───────────────────────────────────────────────────────
SERVER_CMD=("$PY" "$SERVER" --mode "$MODE" --checkpoint "$CHECKPOINT")

if [[ "$AGENT" == "ppo" ]]; then
  SERVER_CMD+=(--update_every "$PPO_UPDATE_EVERY")
  SERVER_CMD+=(--save_every_episodes "$PPO_SAVE_EVERY")
  if [[ "$GREEDY" == true ]] && [[ "$MODE" == "eval" ]]; then
    SERVER_CMD+=(--greedy_eval)
  fi
fi

if [[ "$AGENT" == "dqn" ]]; then
  SERVER_CMD+=(--n_actions      "$DQN_N_ACTIONS")
  SERVER_CMD+=(--lr             "$DQN_LR")
  SERVER_CMD+=(--gamma          "$DQN_GAMMA")
  SERVER_CMD+=(--buf_size       "$DQN_BUF_SIZE")
  SERVER_CMD+=(--batch_size     "$DQN_BATCH_SIZE")
  SERVER_CMD+=(--target_update  "$DQN_TARGET_UPDATE")
  SERVER_CMD+=(--eps_start      "$DQN_EPS_START")
  SERVER_CMD+=(--eps_end        "$DQN_EPS_END")
  SERVER_CMD+=(--eps_decay      "$DQN_EPS_DECAY")
fi

# ── Log file ───────────────────────────────────────────────────────────────────
CKPT_BASE="$(basename "${CHECKPOINT%.pt}")"
if [[ -n "$LOG_OVERRIDE" ]]; then
  LOG="$LOG_OVERRIDE"
elif [[ "$MODE" == "eval" ]]; then
  LOG="$SCRIPT_DIR/eval_${AGENT}_${SCENARIO}_${CKPT_BASE}.csv"
else
  LOG="$SCRIPT_DIR/rollout_${AGENT}_${SCENARIO}.csv"
fi

SERVER_CMD+=(--log "$LOG")

mkdir -p "$SCRIPT_DIR/checkpoints"
mkdir -p "$(dirname "$LOG")"

# ── Summary ────────────────────────────────────────────────────────────────────
echo "┌──────────────────────────────────────────────────"
echo "│  Agent      : $AGENT"
echo "│  Mode       : $MODE"
echo "│  Scenario   : $SCENARIO  (run index $RUN_INDEX)"
echo "│  Episodes   : $NUM_EPISODES"
echo "│  Checkpoint : $CHECKPOINT"
echo "│  Log        : $LOG"
if [[ "$GREEDY" == true ]] && [[ "$AGENT" == "ppo" ]]; then
  echo "│  Policy     : deterministic (greedy)"
fi
echo "└──────────────────────────────────────────────────"
echo ""

# ── Cleanup ────────────────────────────────────────────────────────────────────
SPID=""
cleanup() {
  if [[ -n "${SPID:-}" ]]; then
    kill "$SPID" 2>/dev/null || true
    wait "$SPID" 2>/dev/null || true
    SPID=""
  fi
}
trap cleanup EXIT INT TERM




# ── Run ────────────────────────────────────────────────────────────────────────
cd "$GYM_DIR"

"${SERVER_CMD[@]}" &
SPID=$!
sleep 1

for ep in $(seq 0 $((NUM_EPISODES - 1))); do
  echo "==> Episode $((ep + 1)) / $NUM_EPISODES  [$SCENARIO]"
  "$EXE" -u Cmdenv -n "$NEDPATH" omnetpp.ini -c "$SCENARIO" -r "$RUN_INDEX"
done

cleanup

echo ""
echo "Done: ${AGENT^^} $MODE — $NUM_EPISODES episode(s) on $SCENARIO"
echo "Log : $LOG"