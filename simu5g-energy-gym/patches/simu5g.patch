+
+
+
+
+void VoipSender::handleParameterChange(const char *parname)
+{
+    if (!parname || strcmp(parname, "gymPaused") == 0) {
+        paused = par("gymPaused").boolValue();
+
+        if (paused) {
+            // stop sending immediately
+            if (selfSender_ && selfSender_->isScheduled())
+                cancelEvent(selfSender_);
+        } else {
+            // resume sending immediately (only if we are currently in a talkspurt)
+            if (nframesTmp_ > 0 && selfSender_ && !selfSender_->isScheduled())
+                scheduleAt(simTime(), selfSender_);
+        }
+
+        EV_INFO << "VoipSender gymPaused=" << (paused ? "true" : "false") << "\n";
     }
 }
 
